# Copie para .env e ajuste. NUNCA versione o .env.
POSTGRES_PASSWORD=troque-esta-senha
JWT_SECRET=gere-um-segredo-longo-e-aleatorio-com-32+-caracteres
ENVIRONMENT=production
CORS_ORIGINS=https://seu-dominio.exemplo

# Ponto de partida padrão (é geocodificado e CONFIRMADO no app; não é presumido)
DEFAULT_START_ADDRESS=Rua Joaquim Távora, 480, Santos/SP

# Geocodificação: nominatim (recomenda-se instância própria em produção) | mock (testes)
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# O servidor público exige identificação e no máximo 1 req/s; proibido uso massivo.
NOMINATIM_EMAIL=
GEOCODER_MIN_INTERVAL_S=1.05
GEOCODER_DAILY_QUOTA=5000
GEOCODE_CACHE_DAYS=180

# Roteamento: internal (malha OSM de pedestres própria) | valhalla (servidor próprio, costing pedestrian)
ROUTING_ENGINE=internal
VALHALLA_URL=http://valhalla:8002
# Fonte dos dados OSM para a malha interna: overpass | osmapi | pbf | file
OSM_SOURCE=pbf
OSM_PBF_PATH=/data/santos.osm.pbf
# OVERPASS_ENDPOINTS=https://sua-instancia-overpass/api/interpreter
OPERATION_BBOX=-24.0050,-46.4150,-23.9150,-46.2950

DEFAULT_RIDE_SPEED_KMH=15
DEFAULT_WALK_SPEED_KMH=4.5
DEFAULT_SERVICE_TIME_S=45
SOLVER_TIME_LIMIT_S=20

RETENTION_DAYS=365
RATE_LIMIT_PER_MINUTE=120

# Estilo de mapa (MapLibre). Padrão: OpenFreeMap (gratuito, sem chave; dados OSM).
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
